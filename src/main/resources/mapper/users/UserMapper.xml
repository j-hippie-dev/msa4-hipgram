<?xml version="1.0" encoding="utf-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.msa4hipgram.domain.user.mapper.UserMapper">
    <resultMap id="UserResultMap" type="com.msa4hipgram.domain.user.entities.User">
        <id column="id" property="id" />
        <result column="email" property="email" />
        <result column="password" property="password" />
        <result column="nick" property="nick" />
        <result column="provider" property="provider" />
        <result column="role" property="role" />
        <result column="profile" property="profile" />
        <result column="refresh_token" property="refreshToken" />
        <result column="created_at" property="createdAt" />
        <result column="updated_at" property="updatedAt" />
        <result column="deleted_at" property="deletedAt" />
    </resultMap>

    <select id="findByPk" resultMap="UserResultMap">
        SELECT
            *
        FROM users
        WHERE
                id = #{id} #칼럼명이 왼쪽에 옴. #동작은 하지만 성능이 떨어짐
            AND deleted_at IS NULL
    </select>

    <select id="findByEmail" resultMap="UserResultMap">
        SELECT
            *
        FROM users
        WHERE
              email = #{email} #칼럼명이 왼쪽에 옴. #동작은 하지만 성능이 떨어짐
          AND deleted_at IS NULL
    </select>
</mapper>